PORT=4000
MONGO_URI=mongodb://localhost:27017/gyanpath
REDIS_URL=redis://localhost:6379
# Allowed browser origin(s) for CORS. Comma-separate to allow more than one (e.g. localhost
# plus a LAN IP for phone testing). The client's VITE_API_URL should use the SAME host you
# browse on, or the SameSite=strict session cookie won't be sent back.
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=
CERT_SIGNING_SECRET=
ALERT_WEBHOOK_URL=

# hCaptcha (shown on login after repeated failures). Blank uses hCaptcha's always-pass
# test secret; set your real secret from dashboard.hcaptcha.com in production.
HCAPTCHA_SECRET_KEY=

# WebAuthn / passkeys. Defaults to localhost + CLIENT_ORIGIN for local dev; set these to
# your deployed hostname and https origin in production (rpID is the bare domain).
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=

# Google OAuth login (hand-rolled authorization-code flow — no third-party auth SDK).
# Create an OAuth 2.0 Client (type: Web application) at https://console.cloud.google.com/
# → APIs & Services → Credentials. Add the callback below as an Authorized redirect URI.
# Leave blank to hide/disable the "Continue with Google" button. The redirect URI defaults
# to http://localhost:4000/api/auth/oauth/google/callback when unset.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/oauth/google/callback

# Admin-endpoint IP allow-list (defence in depth on /api/admin/*). Comma-separated exact
# IPs or dotted prefixes, e.g. 203.0.113.7,103.129.135.  — leave blank to disable.
# Loopback is always allowed so local admin access still works.
ADMIN_IP_ALLOWLIST=

# Payments. With no gateway key set, "Enroll" activates instantly (dev mode).

# Khalti (primary) — the sandbox test key works out of the box and its test wallet
# actually settles payments (test login: ID 9800000000, MPIN 1111, OTP 987654):
#   KHALTI_SECRET_KEY=live_secret_key_68791341fdd94846a146f0457ff7b455
# For production, use your live secret key from admin.khalti.com and set the base to
# https://khalti.com/api/v2.
KHALTI_SECRET_KEY=
KHALTI_BASE_URL=https://dev.khalti.com/api/v2

# eSewa (alternative, kept for reference). Sandbox: ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q,
# ESEWA_PRODUCT_CODE=EPAYTEST. For production use your merchant secret + product code and
# point the URLs at epay.esewa.com.np. (eSewa's RC sandbox often won't settle test payments.)
ESEWA_SECRET_KEY=
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_PAYMENT_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/

# Gmail (OTP + password-reset emails). Leave blank to log codes to the server console
# instead. To send real email: enable 2-Step Verification on the Google account, create
# an App Password at https://myaccount.google.com/apppasswords, and paste the 16-char
# value below (no spaces).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# where lesson video files live (optional; defaults to server/media)
MEDIA_DIR=
