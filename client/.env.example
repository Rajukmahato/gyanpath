VITE_API_URL=http://localhost:4000

# hCaptcha sitekey for the login challenge (shown after repeated failed attempts).
# Blank falls back to hCaptcha's public test sitekey, which always passes and renders
# a "for testing only" notice in the widget — get a real one from dashboard.hcaptcha.com
# and add localhost + 127.0.0.1 to its allowed hostnames. Pairs with HCAPTCHA_SECRET_KEY
# on the server; both must be set or verification is meaningless.
VITE_HCAPTCHA_SITE_KEY=
